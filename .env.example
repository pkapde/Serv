# Local demo: no warehouse or LLM credentials required.
APP_ENV=demo
MODEL_PATH=examples/cx.ossie.yaml
DATABASE_URL=sqlite:///var/service.db
DEMO_DATABASE_PATH=var/warehouse.duckdb
RESOLVER_MODE=fixture
EXECUTION_MODE=demo
DEFAULT_WAREHOUSE=snowflake
API_TOKENS={"local-demo-token":"demo-user"}
ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]
ROW_CAP=5000
QUERY_TIMEOUT_SECONDS=60
MAX_CONCURRENCY=4
MODEL_CONTEXT_FRACTION=0.5
LLM_CONTEXT_WINDOW=128000
LLM_BASE_URL=https://your-approved-endpoint.example/v1
LLM_API_KEY=
LLM_MODEL=
# Production: APP_ENV=production, RESOLVER_MODE=llm, EXECUTION_MODE=live,
# PostgreSQL DATABASE_URL, and independent read-only warehouse accounts.
# Supply secrets through environment injection (e.g. AWS Secrets Manager).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
TERADATA_HOST=
TERADATA_USER=
TERADATA_PASSWORD=
TERADATA_DATABASE=
