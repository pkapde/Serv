# Copy to .env on the standalone test system. Never commit the real API key.
# This entry point reads MCP_ settings and forces LLM + local DuckDB execution.
MCP_LLM_BASE_URL=https://your-compatible-endpoint.example/v1
MCP_LLM_API_KEY=
MCP_LLM_MODEL=
MCP_API_TOKENS={"local-demo-token":"demo-user"}
MCP_MODEL_PATH=examples/cx.ossie.yaml
MCP_DATABASE_URL=sqlite:///var/llm-test-service.db
MCP_DEMO_DATABASE_PATH=var/warehouse.duckdb
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]
